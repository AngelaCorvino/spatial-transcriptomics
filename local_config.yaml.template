# Local Configuration Template
# 
# Copy this file to local_config.yaml and fill in your LOCAL paths.
# This file is gitignored to prevent committing local absolute paths.
# 
# The config.load_config() function will merge these settings with defaults.
# On SCG use configs/cluster.yaml instead; it defines the thymus project's
# raw_data under /oak/stanford/groups/dirbas/Angela/thymus_9h/ and
# processed_data under /labs/dirbas/acorvino/thymus_9h/ (both hosted on Oak).

# Absolute path to data directory (optional - defaults to repo_root/data)
# data_dir: /Users/your_username/path/to/large/data/directory

# Absolute path to output/results directory (optional - defaults to repo_root/results)
# output_dir: /Users/your_username/path/to/output/directory

# Cache directory (optional - defaults to repo_root/.cache)
# cache_dir: /Users/your_username/path/to/cache

# Analysis-specific settings (add as needed)
# analysis:
#   n_hvg: 2000
#   resolution: 1.0
